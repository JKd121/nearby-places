# Server-side AMap Web Service key. Never use a NEXT_PUBLIC_ prefix.
AMAP_WEB_SERVICE_KEY=your_web_service_key_here
# Logical credential identity used by AmapOperationBinding; never the secret itself.
AMAP_CREDENTIAL_ID=primary

# Application runtime connection (pooled URL is supported).
DATABASE_URL=postgresql://nearby:change_me@localhost:5432/nearby_dev

# Prisma CLI connection, selected with --config prisma7.config.ts.
# Use the direct connection for your database; local development may use the same URL.
DIRECT_URL=postgresql://nearby:change_me@localhost:5432/nearby_dev
