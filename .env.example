# Server-side AMap Web Service key. Never use a NEXT_PUBLIC_ prefix.
AMAP_WEB_SERVICE_KEY=your_web_service_key_here
# Logical credential identity used by AmapOperationBinding; never the secret itself.
AMAP_CREDENTIAL_ID=primary

# Application runtime connection (pooled URL is supported).
DATABASE_URL=postgresql://nearby:change_me@localhost:5432/nearby_dev

# Prisma CLI connection, selected with --config prisma7.config.ts.
# Use the direct connection for your database; local development may use the same URL.
DIRECT_URL=postgresql://nearby:change_me@localhost:5432/nearby_dev

# Dual identity. Generate three independent random secrets (at least 32 characters).
# verified (default), local-beta (local development only), private-beta (precreated accounts only).
NEARBY_ACCESS_MODE=verified
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-auth-secret-of-at-least-32-characters
NEARBY_GUEST_SECRET=replace-with-a-different-random-guest-secret-of-at-least-32-characters
NEARBY_FINGERPRINT_SECRET=replace-with-a-different-random-fingerprint-secret-of-at-least-32-characters
# Versioned AES-256 keys: each value must be exactly 64 hex characters.
NEARBY_CREDENTIAL_KEY_VERSION=1
NEARBY_CREDENTIAL_KEYS={"1":"replace-with-64-random-hex-characters"}
# SMTP: production requires TLS; set a verified sender and real delivery credentials.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=Nearby <nearby@example.com>
SMTP_USER=
SMTP_PASSWORD=
# Independently configurable identity governance; global upstream concurrency is shared.
NEARBY_GUEST_DAILY_LIMIT=60
NEARBY_GUEST_INTERVAL_MS=500
NEARBY_ACCOUNT_INTERVAL_MS=500
# Functional rollback switch; account login and cloud history stay available.
NEARBY_ACCOUNT_SEARCH_ENABLED=true
NEARBY_MAX_UPSTREAM_CONCURRENT=12
# Explicit local disposable databases for integration/E2E commands only.
# NEARBY_IDENTITY_TEST_DATABASE_URL=postgresql://nearby:test@127.0.0.1:5432/nearby_identity_test_local
