{
  "name": "amap-nearby-spike",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev --webpack",
    "build:core": "tsc -p tsconfig.core.json",
    "check:core": "tsc -p tsconfig.core.json --noEmit",
    "build:web": "next build --webpack",
    "check:web": "next typegen && tsc --noEmit -p tsconfig.json",
    "build": "npm run build:core && npm run build:web",
    "check": "npm run check:core && npm run check:web",
    "test": "node -e \"console.error('Intentional CI gate fixture'); process.exit(1)\"",
    "build:test-route": "tsc --target ES2022 --module ESNext --moduleResolution Bundler --rootDir . --outDir dist --strict --esModuleInterop --skipLibCheck app/api/history/route.ts",
    "smoke": "npm run build:core --silent && node dist/scripts/amap-smoke-test.js",
    "resolver:spike": "npm run build:core --silent && node dist/scripts/spikes/location-intent-spike.js",
    "resolver:address-micro": "npm run build:core --silent && node dist/scripts/spikes/location-intent-spike.js --address-micro",
    "result-card:spike": "npm run build:core --silent && node dist/scripts/spikes/result-card-enrichment-spike.js",
    "result-card:photo-review": "npm run build:core --silent && node dist/scripts/spikes/result-card-enrichment-spike.js --phase-b",
    "check:boundary": "node scripts/check-amap-boundary.mjs",
    "test:admission:postgres": "npm run build:core --silent && node --conditions=react-server --test dist/test/admission-postgres.test.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^18.0.1",
    "next": "^16.3.3",
    "pg": "^8.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "@vercel/functions": "3.6.1"
  }
}
