{
  "name": "amap-nearby-spike",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/generate-prisma.mjs",
    "dev": "next dev --webpack",
    "build:core": "tsc -p tsconfig.core.json",
    "check:core": "tsc -p tsconfig.core.json --noEmit",
    "build:web": "next build --webpack",
    "check:web": "next typegen && tsc --noEmit -p tsconfig.json",
    "build": "npm run build:core && npm run build:web && node scripts/mark-test-build.mjs",
    "check": "npm run check:core && npm run check:web",
    "test": "npm run check:boundary && npm run build:core --silent && npm run build:test-route --silent && node test/run-unit.mjs",
    "build:test-route": "tsc --target ES2022 --module ESNext --moduleResolution Bundler --rootDir . --outDir dist --strict --esModuleInterop --skipLibCheck app/api/history/route.ts",
    "smoke": "npm run build:core --silent && node dist/scripts/amap-smoke-test.js",
    "resolver:spike": "npm run build:core --silent && node dist/scripts/spikes/location-intent-spike.js",
    "resolver:address-micro": "npm run build:core --silent && node dist/scripts/spikes/location-intent-spike.js --address-micro",
    "result-card:spike": "npm run build:core --silent && node dist/scripts/spikes/result-card-enrichment-spike.js",
    "result-card:photo-review": "npm run build:core --silent && node dist/scripts/spikes/result-card-enrichment-spike.js --phase-b",
    "check:boundary": "node scripts/check-amap-boundary.mjs",
    "test:admission:postgres": "npm run build:core --silent && node --conditions=react-server --test dist/test/admission-postgres.test.js",
    "test:browser": "node scripts/test-evidence.mjs browser",
    "test:history:integration": "node scripts/test-evidence.mjs history",
    "test:browser:report": "playwright show-report playwright-report/browser",
    "test:history:report": "playwright show-report playwright-report/history",
    "test:api:run": "npm run build:core --silent && npm run build:test-route --silent && node test/run-api.mjs",
    "test:api": "node scripts/test-evidence.mjs api",
    "test:browser:run": "playwright test",
    "test:history:run": "playwright test --config playwright.history.config.ts",
    "test:acceptance": "node scripts/test-evidence.mjs acceptance"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@vercel/functions": "3.6.1",
    "dotenv": "^18.0.1",
    "next": "^16.3.3",
    "pg": "^8.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1"
  }
}
